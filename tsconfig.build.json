{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "lib/types",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/index.ts", "src/rewind.ts", "src/snapshot.ts", "src/session-cwd.ts"]
}
